<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.FeeAssignmentDialogController">
    <VBox prefHeight="630.0" prefWidth="430.0" spacing="15.0"
          AnchorPane.bottomAnchor="10.0"
          AnchorPane.leftAnchor="10.0"
          AnchorPane.rightAnchor="10.0"
          AnchorPane.topAnchor="10.0">

        <!-- ************************************ -->
        <!-- * EXISTING FEE ASSIGNMENT SECTION * -->
        <!-- ************************************ -->
        <Label text="Assign New Fee Obligation" textFill="#006699">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Separator prefWidth="200.0" />
        <GridPane hgap="10.0" prefHeight="172.0" prefWidth="430.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="310.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Student ID:" />
                <TextField fx:id="studentIdField" promptText="e.g., 1001" GridPane.columnIndex="1" />
                <Label text="Fee Type:" GridPane.rowIndex="1" />
                <ComboBox fx:id="feeTypeComboBox" prefWidth="200.0" promptText="Select Type" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Amount Due (₹):" GridPane.rowIndex="2" />
                <TextField fx:id="amountDueField" promptText="e.g., 15000.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Due Date:" GridPane.rowIndex="3" />
                <DatePicker fx:id="dueDateField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        <Label text="Description (Optional):" />
        <TextArea fx:id="descriptionArea" prefHeight="80.0" prefWidth="430.0" promptText="Brief details about the fee, e.g., 'Spring 2024 Semester Tuition'" VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="430.0" spacing="10.0">
            <Button mnemonicParsing="false" onAction="#handleOk" style="-fx-background-color: #008CBA; -fx-text-fill: white; -fx-font-weight: bold;" text="Save Fee">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
            <padding>
                <Insets top="10.0" />
            </padding>
        </HBox>

        <!-- ************************************* -->
        <!-- * NEW MANUAL STATUS UPDATE SECTION * -->
        <!-- ************************************* -->
        <Separator prefWidth="200.0" />
        <Label text="Manual Fee Status Update" textFill="#E67E22">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="310.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Fee Record ID:" />
                <!-- This field will receive the ID to be updated. User must manually type it here. -->
                <TextField fx:id="feeRecordIdField" promptText="ID of the record to update (e.g., 5)" GridPane.columnIndex="1" />

                <Label text="New Status:" GridPane.rowIndex="1" />
                <ChoiceBox fx:id="statusChoiceBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <Button mnemonicParsing="false" onAction="#handleManualStatusUpdate" style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Update Status Manually">
            <font>
                <Font size="14.0" />
            </font>
        </Button>
        <!-- The Status Label below is reused to show feedback for the update -->
        <Label fx:id="statusMessageLabel" textFill="#2C3E50">
            <font>
                <Font size="12.0" />
            </font>
        </Label>

    </VBox>
</AnchorPane>
