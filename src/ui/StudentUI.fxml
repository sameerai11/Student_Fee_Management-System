<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.StudentController">

    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

    <Label fx:id="welcomeLabel" text="Welcome, Student" style="-fx-text-fill: #007bff;">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>

    <Label text="Your Fee Status" style="-fx-font-weight: bold; -fx-text-fill: #343a40;" />

    <TableView fx:id="studentFeeTable" VBox.vgrow="ALWAYS" prefHeight="300" maxWidth="900.0">
        <columns>
            <TableColumn fx:id="sfIdColumn" prefWidth="80.0" text="Assign ID" />
            <TableColumn fx:id="sfFeeTypeColumn" prefWidth="150.0" text="Fee Type ID" />
            <TableColumn fx:id="sfAmountColumn" prefWidth="100.0" text="Amount (₹)" />
            <TableColumn fx:id="sfDueDateColumn" prefWidth="120.0" text="Due Date" />
            <TableColumn fx:id="sfStatusColumn" prefWidth="100.0" text="Status" />
            <TableColumn fx:id="sfDescriptionColumn" prefWidth="200.0" text="Description" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label text="Your Transaction History" style="-fx-font-weight: bold; -fx-text-fill: #343a40; -fx-padding: 10 0 0 0;" />

    <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" prefHeight="200" maxWidth="900.0">
        <columns>
            <TableColumn fx:id="trxIdColumn" prefWidth="80.0" text="TRX ID" />
            <TableColumn fx:id="trxFeeIdColumn" prefWidth="150.0" text="Assigned Fee ID" />
            <TableColumn fx:id="trxAmountColumn" prefWidth="100.0" text="Amount Paid" />
            <TableColumn fx:id="trxDateColumn" prefWidth="200.0" text="Date" />
            <TableColumn fx:id="trxMethodColumn" prefWidth="150.0" text="Method" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Button text="Refresh Data" onAction="#loadStudentData" style="-fx-background-color: #17a2b8; -fx-text-fill: white;" />

    <Label fx:id="statusLabel" text="Data initialized." style="-fx-text-fill: #343a40; -fx-font-style: italic; -fx-padding: 10 0 0 0;" />

</VBox>