<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-border-color: #ccc; -fx-border-radius: 5; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.FeePaymentDialogController">
    <children>
        <Label fx:id="titleLabel" text="Edit Fee Type" style="-fx-text-fill: #007bff;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <VBox spacing="5.0">
            <children>
                <Label text="Fee Name:" />
                <TextField fx:id="feeNameField" promptText="Annual Tuition Fee" />
            </children>
        </VBox>
        <VBox spacing="5.0">
            <children>
                <Label text="Amount (₹):" />
                <TextField fx:id="amountField" promptText="e.g., 50000.00" />
            </children>
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel" style="-fx-background-color: #6c757d; -fx-text-fill: white;" />
                <Button mnemonicParsing="false" onAction="#handleOk" text="Save Changes" style="-fx-background-color: #28a745; -fx-text-fill: white;" />
            </children>
        </HBox>
        <Label fx:id="statusLabel" minHeight="18.0" style="-fx-text-fill: red;" />
    </children>
</VBox>